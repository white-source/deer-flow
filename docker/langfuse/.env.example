# Langfuse self-hosted secrets (copy to docker/langfuse/.env).
# Generate: openssl rand -base64 32  (NEXTAUTH_SECRET)
#           openssl rand -base64 16  (SALT)
#           openssl rand -hex 32       (ENCRYPTION_KEY)

NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=changeme-generate-with-openssl
SALT=changeme-generate-with-openssl
ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32

POSTGRES_PASSWORD=changeme-postgres
CLICKHOUSE_PASSWORD=changeme-clickhouse
REDIS_AUTH=changeme-redis
MINIO_ROOT_PASSWORD=changeme-minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=changeme-minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=changeme-minio
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=changeme-minio
